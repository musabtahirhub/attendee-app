# ──────────────────────────────────────────────
# Attendance System — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
#
#   cp .env.example .env
#
# The app reads these via python-dotenv at startup.
# ──────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Local development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db
#
# Render (use the "Internal Database URL" from your Render PostgreSQL dashboard):
# DATABASE_URL=postgresql://user:password@host/attendance_db
#
# Railway (auto-injected — usually no need to set manually):
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Google Gemini API Key (Get key from https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# Chatbot AI Model Configuration
MODEL_NAME=gemini-2.0-flash
MODEL_TEMPERATURE=0
MODEL_MAX_RETRIES=0
PROMPT_VERSION=v1.0.0
